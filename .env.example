# Copy to .env.local for local development (or run `vercel env pull .env.local`).
# Empty values count as unset. Each group is validated on first use, so only the
# variables a feature needs must be set. From Phase 2, `pnpm env:check` reports every group.
# Vercel also injects VERCEL_OIDC_TOKEN, BLOB_STORE_ID, PG* and POSTGRES_* variables;
# the app does not read them, and the Blob token below is passed explicitly to every Blob call.

# Pooled Neon connection string used by the app at runtime (postgres:// or postgresql://).
DATABASE_URL=
# Direct (unpooled) Neon connection string used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Vercel Blob read-write token (starts with vercel_blob_rw_); include Development when connecting the store.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key; server-side only.
ANTHROPIC_API_KEY=
# Optional tagging model override (must be a priced model; default claude-haiku-5-5).
CLAUDE_TAGGING_MODEL=
# Optional relocation analysis model override (must be a priced model; default claude-sonnet-5-5).
CLAUDE_ANALYSIS_MODEL=
# Optional outfit suggestion model override (must be a priced model; defaults to the analysis model).
CLAUDE_OUTFIT_MODEL=
# Thinking effort for the relocation analysis: low, medium or high (default medium).
CLAUDE_ANALYSIS_EFFORT=
# Hard monthly AI spend limit in USD (UTC calendar month).
MONTHLY_AI_BUDGET_USD=20
# Total API credit in USD, shown against all-time spend on the usage page.
AI_CREDIT_USD=100

# Base64 of a bcrypt hash of the login password; generate it with `pnpm hash-password`.
APP_PASSWORD_HASH=
# Session cookie signing secret, at least 32 characters (`pnpm hash-password --with-secret` prints one).
SESSION_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/*, at least 16 characters.
CRON_SECRET=

# Enables the AI "what to buy next" analysis: true or false.
FEATURE_SHOPPING_AI=false

# Test-only: E2E_TAG=1 makes the e2e smoke spec tag with Claude. Set it in the shell for that run, with ANTHROPIC_API_KEY and BLOB_READ_WRITE_TOKEN, because Playwright does not read .env.local.
E2E_TAG=
# Vercel dashboard only (set it to 1 there) so the build uses the pnpm version from packageManager.
ENABLE_EXPERIMENTAL_COREPACK=
